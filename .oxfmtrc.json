{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"arrowParens": "always",
	"bracketSpacing": true,
	"bracketSameLine": true,
	"printWidth": 100,
	"semi": true,
	"singleQuote": false,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true,
	"sortPackageJson": false,
	"ignorePatterns": ["node_modules", "dist", ".astro", ".claude", ".agents", ".codex", ".vscode"]
}
