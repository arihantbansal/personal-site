---
import { site } from "@/data/site";
import { markdownPathFor } from "@/data/pages";
import "@/styles/global.css";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title = site.name, description = site.description, noindex = false } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, site.url);
const imageUrl = new URL("/opengraph-image.jpg", site.url);
const cloudflareToken = "94d58999a13442ed9c54f58f2fd7d171";
const personId = `${site.url}/#person`;
const isHome = Astro.url.pathname === "/";
const markdownPath = markdownPathFor(Astro.url.pathname);
const imageAlt =
	"An aquatint view of the monumental astronomical instruments at Jantar Mantar in Delhi.";

const profileJsonLd = isHome && !noindex
	? {
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "WebSite",
					"@id": `${site.url}/#website`,
					url: `${site.url}/`,
					name: site.name,
				},
				{
					"@type": "ProfilePage",
					"@id": `${canonicalUrl}#webpage`,
					url: canonicalUrl,
					name: title,
					description,
					dateModified: site.updatedAt,
					mainEntity: { "@id": personId },
					isPartOf: { "@id": `${site.url}/#website` },
				},
				{
					"@type": "Person",
					"@id": personId,
					name: site.name,
					url: `${site.url}/`,
					jobTitle: site.jobTitle,
					description: site.description,
					sameAs: site.socials.map(({ href }) => href),
					alumniOf: {
						"@type": "CollegeOrUniversity",
						name: site.education.campus,
						url: site.education.href,
					},
					knowsAbout: site.profile.knowsAbout,
				},
				{
					"@type": "TechArticle",
					"@id": site.experience.paper.href,
					url: site.experience.paper.href,
					name: site.experience.paper.label,
					headline: site.experience.paper.title,
					datePublished: site.experience.paper.datePublished,
					author: site.experience.paper.authors.map((name) =>
						name === site.name
							? { "@id": personId }
							: {
									"@type": "Person",
									name,
								},
					),
				},
			],
		}
	: undefined;

const structuredData = profileJsonLd
	? JSON.stringify(profileJsonLd).replaceAll("<", "\\u003c")
	: undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#fbfbfa" />
		<script is:inline>
			(() => {
				let storedTheme;
				try {
					storedTheme = localStorage.getItem("theme");
				} catch {
					// Theme preferences are optional when browser storage is unavailable.
				}
				const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
				const theme = storedTheme === "light" || storedTheme === "dark"
					? storedTheme
					: prefersDark
						? "dark"
						: "light";

				document.documentElement.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]')?.setAttribute(
					"content",
					theme === "dark" ? "#181817" : "#fbfbfa",
				);
			})();
		</script>
		<meta name="description" content={description} />
		<meta name="author" content={site.name} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		{!noindex && <link rel="canonical" href={canonicalUrl} />}
		<link rel="describedby" href="/llms.txt" />
		{markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
		<link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any" />
		<link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
		<link rel="apple-touch-icon" href="/apple-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:creator" content="@arihantbansal" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<title>{title}</title>
		{structuredData && <script is:inline type="application/ld+json" set:html={structuredData} />}
	</head>
	<body>
		<header class="site-header">
			{
				isHome ? (
					<h1 class="wordmark">
						<a href="/" aria-label={`${site.name}, home`}>{site.name}</a>
					</h1>
				) : (
					<a class="wordmark" href="/" aria-label={`${site.name}, home`}>{site.name}</a>
				)
			}
			<div class="site-actions">
				<nav aria-label="Elsewhere">
					{site.socials.map(({ label, href }) => <a href={href} rel="me">{label}</a>)}
				</nav>
				<button
					class="theme-toggle"
					type="button"
					data-theme-toggle
					hidden
					aria-label="Use dark theme"
				></button>
			</div>
		</header>

		<slot />

		<script is:inline>
			(() => {
				const themeToggle = document.querySelector("[data-theme-toggle]");
				if (!themeToggle) return;

				const themeColor = document.querySelector('meta[name="theme-color"]');

				const updateThemeControl = () => {
					const isDark = document.documentElement.dataset.theme === "dark";
					themeToggle.setAttribute("aria-label", isDark ? "Use light theme" : "Use dark theme");
				};

				const applyTheme = (theme) => {
					document.documentElement.dataset.theme = theme;
					try {
						localStorage.setItem("theme", theme);
					} catch {
					// Theme preferences are optional when browser storage is unavailable.
				}
					if (themeColor) {
						themeColor.setAttribute("content", theme === "dark" ? "#181817" : "#fbfbfa");
					}
					updateThemeControl();
				};

				themeToggle.removeAttribute("hidden");
				updateThemeControl();

				themeToggle.addEventListener("click", () => {
					const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
					applyTheme(nextTheme);
				});
			})();
		</script>

		<script
			is:inline
			defer
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={JSON.stringify({ token: cloudflareToken })}
		></script>

		<!--
			hey, arihant here.
			if you have a good crime thriller recommendation, send it my way.
		-->
	</body>
</html>
