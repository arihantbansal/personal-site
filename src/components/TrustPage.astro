---
import type { ContentPage } from "../data/pages";
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
	content: ContentPage;
}

const { content } = Astro.props;
---

<BaseLayout title={content.title} description={content.description}>
	<main>
		<article class="trust-page">
			<h1>{content.title}</h1>
			<p class="lead">{content.introduction}</p>

			{
				content.sections.map(({ heading, paragraphs }) => (
					<section>
						<h2>{heading}</h2>
						{paragraphs.map((paragraph) => <p>{paragraph}</p>)}
					</section>
				))
			}

			<section>
				<h2>{content.linksHeading}</h2>
				<ul class="reference-list">
					{
						content.links.map(({ label, href, detail }) => (
							<li>
								<a href={href}>{label}</a>: {detail}
							</li>
						))
					}
				</ul>
			</section>
		</article>
	</main>
</BaseLayout>
