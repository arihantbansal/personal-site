<script>
	const paragraph = document.querySelector<HTMLElement>("[data-hobbies]");

	if (paragraph) {
		const details: Record<string, { kind: string; emoji: string }> = {
			"crime thrillers": { kind: "book", emoji: "🔎" },
			music: { kind: "music", emoji: "🎵" },
			"video games": { kind: "game", emoji: "🎮" },
		};
		const fragments = paragraph.textContent!.split(/(music|crime thrillers|video games)/);
		const hover = matchMedia("(hover: hover)");
		let active: HTMLButtonElement | undefined;
		let timer: ReturnType<typeof setTimeout> | undefined;

		function clear() {
			clearTimeout(timer);
			active?.classList.remove("quiet-playing");
			active = undefined;
		}

		function play(button: HTMLButtonElement, held: boolean) {
			clear();
			// Flush the removed animation so rapid clicks restart it.
			void button.getBoundingClientRect();
			active = button;
			button.classList.add("quiet-playing");
			if (!held) timer = setTimeout(clear, 1600);
		}

		paragraph.replaceChildren();
		for (const fragment of fragments) {
			const detail = details[fragment];
			if (!detail) {
				paragraph.append(document.createTextNode(fragment));
				continue;
			}

			const button = document.createElement("button");
			button.type = "button";
			button.className = "quiet-word";
			button.dataset.kind = detail.kind;
			button.textContent = fragment;

			const emoji = document.createElement("span");
			emoji.className = "quiet-emoji";
			emoji.setAttribute("aria-hidden", "true");
			emoji.textContent = detail.emoji;
			button.append(emoji);
			paragraph.append(button);

			button.addEventListener("pointerenter", (event) => {
				if (event.pointerType === "mouse") play(button, true);
			});
			button.addEventListener("focus", () => {
				if (button.matches(":focus-visible")) play(button, true);
			});
			button.addEventListener("pointerleave", () => {
				if (active === button && !button.matches(":focus-visible")) clear();
			});
			button.addEventListener("blur", () => {
				if (active === button && !button.matches(":hover")) clear();
			});
			button.addEventListener("click", (event) => {
				play(button, event.detail === 0 || (hover.matches && button.matches(":hover")));
			});
		}
		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") clear();
		});
	}
</script>

<style is:global>
