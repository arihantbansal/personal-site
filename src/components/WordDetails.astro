		text-decoration-color: transparent;
		box-shadow:
			3px 0 #211d70,
			-3px 0 #211d70;
	}
	@media (prefers-reduced-motion: reduce) {
		.wordmark a::after,
		.quiet-emoji {
			animation: none !important;
		}
		.wordmark a:is(:hover, :focus-visible)::after,
		.quiet-playing .quiet-emoji {
