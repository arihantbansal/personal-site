---
import { site } from "@/data/site";

const hobbies = new Map([
	["crime thrillers", "🔎"],
	["music", "🎵"],
	["video games", "🎮"],
]);
const fragments = site.profile.outside.split(/(crime thrillers|music|video games)/);
---

<p>
	{fragments.map((text) => {
		const emoji = hobbies.get(text);
		return emoji ? (
			<button type="button" aria-label={`Show ${text} emoji`}>
				{text}<span aria-hidden="true">{emoji}</span>
			</button>
		) : text;
	})}
</p>

<style>
	button {
		position: relative;
		display: inline-block;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		letter-spacing: inherit;
		white-space: nowrap;
		cursor: pointer;
		text-decoration: underline dotted var(--secondary) 1px;
		text-underline-offset: 0.2em;
	}
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
	span {
		position: absolute;
		left: 50%;
		bottom: calc(100% - 1px);
		font: 14px/1 "Apple Color Emoji", "Segoe UI Emoji", sans-serif;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 3px);
	}
	button:is(:focus, :active) span {
		opacity: 1;
		transform: translate(-50%, 0);
	}
	@media (hover: hover) {
		button:hover span {
			opacity: 1;
			transform: translate(-50%, 0);
		}
	}
	@media (prefers-reduced-motion: no-preference) {
		span {
			transition: opacity 150ms ease-out, transform 150ms ease-out;
		}
	}
</style>
