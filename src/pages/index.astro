---
import Inline from "@/components/Inline.astro";
import { site } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
	<main>
		<img
			class="hero"
			src={site.hero.src}
			width={site.hero.width}
			height={site.hero.height}
			alt={site.hero.alt}
			title={site.hero.credit}
			decoding="async"
			fetchpriority="high"
		/>

		{
			site.intro.map((paragraph) => (
				<p>
					<Inline text={paragraph} />
				</p>
			))
		}

		<section aria-labelledby="projects">
			<h2 id="projects">Side projects</h2>
			<ul class="projects">
				{
					site.projects.map(({ name, href, description }) => (
						<li>
							<a href={href} target="_blank" rel="noopener">
								<span class="name">{name}</span>
								<span class="description">{description}</span>
								<span class="arrow" aria-hidden="true">
									↗
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section aria-labelledby="outside">
			<h2 id="outside">Outside work</h2>
			<p>{site.outsideWork}</p>
		</section>
	</main>
</BaseLayout>

<style>
	.hero {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 36px;
		border-radius: 4px;
	}

	:global(:root[data-theme="dark"]) .hero {
		filter: brightness(0.82) contrast(1.05);
	}

	.projects {
		padding: 0;
		border-top: 1px solid var(--rule);
		list-style: none;
	}

	.projects li {
		border-bottom: 1px solid var(--rule);
	}

	.projects a {
		display: grid;
		grid-template-columns: 140px 1fr auto;
		gap: 16px;
		align-items: baseline;
		padding-block: 11px;
		text-decoration: none;
	}

	.name {
		font-family: var(--mono);
		font-size: 0.84em;
	}

	.description,
	.arrow {
		color: var(--secondary);
	}

	.projects a:hover .description,
	.projects a:hover .arrow {
		color: var(--accent);
	}

	@media (max-width: 560px) {
		.projects a {
			grid-template-columns: 1fr auto;
			gap: 2px 12px;
		}

		.description {
			grid-column: 1;
		}

		.arrow {
			grid-row: 1;
			grid-column: 2;
		}
	}
</style>
