---
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
	<main>
		<section class="profile" aria-label="About Arihant">
			<p class="lead">{site.profile.introduction}</p>
			<p class="experience">
				Previously, I joined <a href={site.experience.href}
					>{site.experience.organization}</a
				> as its third employee while still at university. Over three years, I{
					" "
				}{site.experience.scope}. I also co-authored the <a
					href={site.experience.paper.href}>{site.experience.paper.label}</a
				>.
			</p>

			<p>
				My undergraduate research, <a href={site.research.href}>{site.research.title}</a>,
				explored federated learning without a central coordinator and was published at ACM
				Middleware 2025.
			</p>

			<p>
				I studied {site.education.degree} at <a href={site.education.href}
					>{site.education.institution}</a
				>.
			</p>
			<p>{site.profile.outside}</p>
		</section>
	</main>
</BaseLayout>
