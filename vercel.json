{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "astro",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				},
				{
					"key": "Permissions-Policy",
					"value": "camera=(), microphone=(), geolocation=()"
				}
			]
		},
		{
			"source": "/(.*).md",
			"headers": [
				{
					"key": "Content-Type",
					"value": "text/markdown; charset=utf-8"
				}
			]
		},
		{
			"source": "/",
			"headers": [
				{
					"key": "Vary",
					"value": "Accept"
				}
			]
		}
	],
	"rewrites": [
		{
			"source": "/",
			"has": [
				{
					"type": "header",
					"key": "accept",
					"value": "(.*)text/markdown(.*)"
				}
			],
			"destination": "/index.md"
		},
		{
			"source": "/gpu-color",
			"destination": "https://gpu-color.vercel.app/"
		},
		{
			"source": "/gpu-color/",
			"destination": "https://gpu-color.vercel.app/"
		},
		{
			"source": "/gpu-color/:path*",
			"destination": "https://gpu-color.vercel.app/:path*"
		}
	]
}
